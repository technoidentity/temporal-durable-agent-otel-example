# Local development environment overrides.
# Copy to `.env` and fill in. Never commit real secrets.
#
# Precedence: these environment variables override config/config.yaml, which
# overrides model defaults.

# --- LLM ---------------------------------------------------------------------
# provider: openai | fake  (fake runs the full flow offline, no key needed)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Temporal (self-hosted, the default) ------------------------------------
TEMPORAL_MODE=self_hosted
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=langgraph-agent

# --- Temporal Cloud (only when TEMPORAL_MODE=cloud) -------------------------
# TEMPORAL_MODE=cloud
# TEMPORAL_CLOUD_ADDRESS=my-namespace.acct.tmprl.cloud:7233
# TEMPORAL_CLOUD_NAMESPACE=my-namespace.acct
# TEMPORAL_CLOUD_API_KEY=

# --- Observability -----------------------------------------------------------
OBSERVABILITY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- Temporal Cloud service metrics (scraped by the collector, optional) ----
TEMPORAL_CLOUD_METRICS_ENABLED=false
TEMPORAL_METRICS_API_KEY=

# --- Infrastructure ----------------------------------------------------------
INFRA_AUTO_START=true
